PORT=8080
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# MySQL
TRACKER_MYSQL_HOST=
TRACKER_MYSQL_PORT=3306
TRACKER_MYSQL_USER=
TRACKER_MYSQL_PASSWORD=
TRACKER_MYSQL_DATABASE=dev_tracker

# AWS S3 – file attachments (auth via EC2 IAM role, no access keys)
AWS_REGION=
AWS_S3_BUCKET=

# AWS SES – must be a verified identity
SES_FROM_EMAIL=
# Public app URL used for links in emails (optional)
APP_URL=
