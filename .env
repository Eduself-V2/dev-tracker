PORT=8080
SESSION_SECRET=any-random-string-you-choose

# MySQL
TRACKER_MYSQL_HOST=your-db-instance.xxxxxxxx.ap-southeast-1.rds.amazonaws.com
TRACKER_MYSQL_PORT=3306
TRACKER_MYSQL_USER=your_db_user
TRACKER_MYSQL_PASSWORD=your_db_password
TRACKER_MYSQL_DATABASE=dev_tracker

# AWS S3 – file attachments
# No access keys needed — EC2 IAM role (demo-pre-production-role) handles auth
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=dev-tracker-production

# AWS SES – email notifications
# Must be a verified identity in SES (email address or domain)
SES_FROM_EMAIL=SES_FROM_EMAIL=noreply@eduself.top
# Your app's public URL — used to generate task links inside emails (optional)
APP_URL=https://dev-tracker.eduself.top